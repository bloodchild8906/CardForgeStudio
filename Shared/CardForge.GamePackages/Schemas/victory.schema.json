{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardforge.local/schemas/victory-1.json",
  "title": "CardForge Victory Definitions",
  "type": "object",
  "required": ["version", "rules"],
  "properties": {
    "version": { "const": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "outcome", "scope", "operator", "threshold"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" },
          "kind": { "enum": ["resource-threshold", "empty-zone", "last-player-standing", "turn-limit"] },
          "outcome": { "enum": ["win", "eliminate"] },
          "scope": { "enum": ["player", "game"] },
          "operator": { "enum": ["less-than", "less-than-or-equal", "equal", "greater-than-or-equal", "greater-than"] }
        }
      }
    }
  }
}
