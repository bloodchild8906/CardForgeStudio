{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardforge.local/schemas/game-package-manifest-1.0.json",
  "title": "CardForge Game Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "gameId", "name", "version", "createdUtc", "rulePackPath", "victoryDefinitionsPath", "content", "files"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "packageId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" },
    "gameId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "maxLength": 2000 },
    "createdUtc": { "type": "string", "format": "date-time" },
    "sourceEditor": { "type": "string" },
    "rulePackPath": { "type": "string" },
    "victoryDefinitionsPath": { "type": "string" },
    "content": { "type": "object" },
    "files": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "length", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "kind": { "enum": ["cards", "zones", "frames", "assets", "actions", "abilities", "keywords", "turn-flow", "triggers", "rules", "victory", "schema", "block"] },
          "length": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        }
      }
    }
  }
}
