{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardforge.local/schemas/rule-pack-2.json",
  "title": "CardForge Authoritative Rule Pack",
  "type": "object",
  "required": ["id", "name", "version", "description", "cards", "startingRules", "schemaVersion", "gameSystem", "minimumPlayers", "maximumPlayers", "zones", "resources", "phases", "actions"],
  "properties": {
    "schemaVersion": { "const": "2" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" },
    "version": { "type": "string" },
    "minimumPlayers": { "type": "integer", "minimum": 1 },
    "maximumPlayers": { "type": "integer", "minimum": 1 },
    "cards": { "type": "array", "minItems": 1 },
    "zones": { "type": "array", "minItems": 1 },
    "resources": { "type": "array" },
    "phases": { "type": "array", "minItems": 1 },
    "actions": { "type": "array", "minItems": 1 }
  }
}
