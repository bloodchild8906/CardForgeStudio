/* CardForge Astral Rift — runtime Unity UI Toolkit skin.
 * Purposefully presentation-only: the authoritative match state remains on the server.
 */
.cf-nav {
    height: 38px;
    min-width: 76px;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 14px;
    padding-right: 14px;
    border-bottom-width: 2px;
    border-bottom-color: #26374D;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    color: #B6C4D9;
    background-color: #111B2D;
    -unity-font-style: bold;
    font-size: 12px;
}
.cf-nav:hover {
    color: #FFFFFF;
    background-color: #293B58;
    border-bottom-color: #E7BD68;
}
.cf-nav--active {
    color: #FFE2A5;
    border-bottom-color: #E7BD68;
    background-color: #273550;
}
.cf-hero {
    background-color: #16243A;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: #50617A;
    border-bottom-color: #50617A;
    border-left-color: #50617A;
    border-right-color: #50617A;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}
.cf-panel {
    background-color: #17243A;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: #344861;
    border-bottom-color: #344861;
    border-left-color: #344861;
    border-right-color: #344861;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
}
.cf-primary {
    height: 43px;
    margin-right: 8px;
    margin-bottom: 5px;
    min-width: 132px;
    padding-left: 18px;
    padding-right: 18px;
    color: #172035;
    background-color: #E7BD68;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    -unity-font-style: bold;
    font-size: 14px;
}
.cf-primary:hover { background-color: #F8D992; }
.cf-primary:disabled { background-color: #69707C; color: #B6BBC5; }
.cf-secondary {
    height: 40px;
    min-width: 112px;
    margin-right: 7px;
    margin-bottom: 6px;
    padding-left: 14px;
    padding-right: 14px;
    color: #E5EFFC;
    background-color: #283A54;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    font-size: 12px;
}
.cf-secondary:hover { color: #FFFFFF; background-color: #3C5574; }
.cf-secondary:disabled { color: #8E9AAA; background-color: #222F41; }
.cf-danger { color: #FFD3CF; background-color: #5C2D39; }
.cf-danger:hover { background-color: #854052; }
.cf-filter { min-width: 79px; }
.cf-filter--active { background-color: #CBA65C; color: #152037; }
.cf-card-face { translate: 0px 0px; }
.cf-card-face:hover { translate: 0px -3px; }
.cf-card-face:focus { translate: 0px -3px; }
.cf-card-back { border-top-color: #D2A959; }
.cf-zone { padding-right: 6px; }
.cf-seat { border-top-left-radius: 9px; border-top-right-radius: 9px; border-bottom-left-radius: 9px; border-bottom-right-radius: 9px; }
.cf-heading { -unity-font-style: bold; }
.cf-deck-card:hover { background-color: #283A52; }
.cf-textfield { margin-bottom: 5px; color: #E5EFFC; }
.cf-scroll { flex-grow: 1; }

/* Arcane arena refresh: stronger tabletop identity and clearer play actions. */
.cf-nav { background-color: #171326; border-bottom-color: #74513A; color: #EAD9BC; border-top-left-radius: 12px; border-top-right-radius: 12px; }
.cf-nav:hover { background-color: #34243C; border-bottom-color: #FFC875; }
.cf-nav--active { background-color: #3A263B; color: #FFE6B1; border-bottom-color: #FFCA75; }
.cf-hero { background-color: #21192D; border-top-color: #8C6549; border-bottom-color: #8C6549; border-left-color: #8C6549; border-right-color: #8C6549; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px; }
.cf-panel { background-color: #211A2D; border-top-color: #60495D; border-bottom-color: #60495D; border-left-color: #60495D; border-right-color: #60495D; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; }
.cf-primary { height: 50px; min-width: 148px; color: #2D1923; background-color: #F1BE6A; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; font-size: 15px; }
.cf-primary:hover { background-color: #FFE0A0; }
.cf-secondary { height: 44px; background-color: #3B2B43; color: #F4E4D2; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; }
.cf-secondary:hover { background-color: #594064; }
.cf-filter--active { background-color: #E7AD63; color: #291B29; }
.cf-card-face:hover { translate: 0px -7px; }
.cf-card-face:focus { translate: 0px -7px; }
.cf-card-back { border-top-color: #F1BE6A; }
.cf-deck-card:hover { background-color: #44304A; }

/* Readability and keyboard affordances across every playable screen. */
.cf-nav { height: 43px; min-width: 82px; padding-left: 13px; padding-right: 13px; font-size: 13px; }
.cf-primary { font-size: 15px; }
.cf-secondary { font-size: 14px; }
.cf-filter { min-width: 85px; }
.cf-textfield { color: #F4EAD8; font-size: 14px; }
.cf-textfield .unity-base-field__label { font-size: 13px; color: #E3D0E0; }
.cf-textfield .unity-base-text-field__input { min-height: 32px; font-size: 14px; color: #F6EEE2; }
.cf-textfield .unity-base-popup-field__input { min-height: 32px; font-size: 14px; }
.cf-primary:focus, .cf-secondary:focus, .cf-nav:focus {
    border-top-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-right-width: 2px;
    border-top-color: #FFE5A5; border-bottom-color: #FFE5A5; border-left-color: #FFE5A5; border-right-color: #FFE5A5;
}
.cf-panel Label, .cf-hero Label { white-space: normal; }
