/* The project overview uses the same Studio surfaces, borders and typography
   as the card, turn-flow, action and ability editors. */
.cf-overview-workspace {
    background-color: var(--cf-color-bg);
    min-height: 0;
    min-width: 0;
}
.cf-overview-scroll {
    background-color: var(--cf-color-bg);
    min-height: 0;
    width: 100%;
}
.cf-overview-page {
    flex-direction: column;
    flex-shrink: 0;
    padding-top: 17px;
    padding-bottom: 32px;
    padding-left: 10px;
    padding-right: 10px;
    max-width: 1020px;
}
.cf-overview-shortcuts {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 13px;
    width: 100%;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 7px;
    background-color: var(--cf-color-surface);
    border-width: 1px;
    border-color: var(--cf-color-border);
    border-radius: 7px;
}
.cf-overview-shortcut {
    height: 33px;
    min-width: 105px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 7px;
    margin-bottom: 3px;
    margin-top: 3px;
    padding-left: 9px;
    padding-right: 9px;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--cf-color-text);
    background-color: var(--cf-color-surface-raised);
    border-width: 1px;
    border-color: var(--cf-color-border);
    border-radius: 6px;
}
.cf-overview-shortcut:hover, .cf-overview-shortcut:focus {
    border-color: var(--cf-color-accent);
    color: var(--cf-color-accent);
}
.cf-overview-heading-actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 3px;
}
.cf-overview-heading-link {
    min-height: 30px;
    padding-left: 9px;
    padding-right: 9px;
    margin-left: 7px;
    margin-bottom: 4px;
    font-size: 11px;
    color: var(--cf-color-accent);
    background-color: var(--cf-color-surface-raised);
    border-width: 1px;
    border-color: var(--cf-color-border);
    border-radius: 6px;
}
.cf-overview-heading-link:hover, .cf-overview-heading-link:focus {
    border-color: var(--cf-color-accent);
    background-color: var(--cf-color-accent-soft);
}
.cf-hub__overview {
    background-color: var(--cf-color-surface);
    border-color: var(--cf-color-border);
    border-radius: 9px;
    margin-bottom: 16px;
    padding-top: 17px;
    padding-bottom: 16px;
}
.cf-hub__overview--studio {
    padding: 16px 18px;
    margin-bottom: 0;
    width: 100%;
}
.cf-hub__overview-title {
    color: var(--cf-color-text);
    font-size: 22px;
}
.cf-hub__overview-head {
    padding-bottom: 9px;
    border-bottom-width: 1px;
    border-bottom-color: var(--cf-color-border);
    margin-bottom: 11px;
}
.cf-hub__overview .cf-hub__eyebrow {
    color: var(--cf-color-accent);
    font-size: 10px;
}
.cf-hub__overview-banner {
    background-color: var(--cf-color-surface-raised);
    border-left-color: var(--cf-color-accent);
    border-bottom-width: 1px;
    border-bottom-color: var(--cf-color-border);
    border-radius: 7px;
    padding: 13px 14px;
    margin-bottom: 13px;
}
.cf-hub__overview-status {
    color: var(--cf-color-accent);
    font-size: 14px;
}
.cf-hub__overview-summary {
    color: var(--cf-color-text-muted);
    font-size: 12px;
}
.cf-hub__overview-play {
    color: #221b18;
    background-color: #d8b574;
    border-color: #f0d79c;
    border-radius: 6px;
    min-height: 36px;
}
.cf-hub__overview-play:hover, .cf-hub__overview-play:focus {
    background-color: #f0d79c;
}
.cf-hub__overview-readiness,
.cf-hub__overview-factions {
    background-color: var(--cf-color-surface-raised);
    border-color: var(--cf-color-border);
    border-radius: 8px;
    padding: 14px;
}
.cf-hub__overview-block-title {
    color: var(--cf-color-text);
    font-size: 14px;
}
.cf-hub__overview-explainer,
.cf-hub__ready-note {
    color: var(--cf-color-text-muted);
}
.cf-hub__ready-row {
    border-bottom-color: var(--cf-color-border);
    min-height: 47px;
}
.cf-hub__ready-title {
    color: var(--cf-color-text);
    font-size: 11px;
}
.cf-hub__ready-link {
    color: var(--cf-color-accent);
    background-color: var(--cf-color-surface);
    border-color: var(--cf-color-border);
    border-radius: 6px;
    min-height: 29px;
}
.cf-hub__ready-link:hover, .cf-hub__ready-link:focus {
    background-color: var(--cf-color-accent-soft);
    border-color: var(--cf-color-accent);
}
.cf-hub__deck {
    background-color: var(--cf-color-surface);
    border-color: var(--cf-color-border);
    border-radius: 8px;
}
.cf-hub__deck-solar {
    border-top-color: #d8b574;
}
.cf-hub__deck-tidal {
    border-top-color: #72a9df;
}
.cf-hub__deck-verdant {
    border-top-color: #70ae96;
}
.cf-hub__deck-name {
    color: var(--cf-color-text);
    font-size: 12px;
}
.cf-hub__deck-description {
    color: var(--cf-color-text-muted);
    font-size: 12px;
}
.cf-hub__deck-count {
    color: var(--cf-color-text-muted);
    font-size: 10px;
}
.cf-hub__deck-action {
    color: var(--cf-color-text);
    background-color: var(--cf-color-surface-raised);
    border-color: var(--cf-color-border);
    border-radius: 6px;
    min-height: 33px;
}
.cf-hub__deck-action:hover, .cf-hub__deck-action:focus {
    color: var(--cf-color-accent);
    border-color: var(--cf-color-accent);
    background-color: var(--cf-color-accent-soft);
}
.cf-theme-light .cf-hub__overview-play {
    color: #ffffff;
    background-color: var(--cf-color-accent);
    border-color: var(--cf-color-accent);
}
